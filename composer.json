{
    "name": "rantailabs/canton-php",
    "description": "PHP client for the Canton JSON Ledger API",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "RantaiLabs\\Canton\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RantaiLabs\\Canton\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "illuminate/support": "To use the Laravel service provider and Canton facade"
    },
    "extra": {
        "laravel": {
            "providers": [
                "RantaiLabs\\Canton\\Laravel\\CantonServiceProvider"
            ],
            "aliases": {
                "Canton": "RantaiLabs\\Canton\\Laravel\\Canton"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
